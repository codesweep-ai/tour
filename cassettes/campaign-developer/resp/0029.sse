data: {"choices":[{"delta":{"tool_calls":[{"function":{"arguments":", \"content\": \"import { useState } from \\\"react\\\";\\nimport { AppShell, Header, Footer, Button } from \\\"@codesweep-ai/ui\\\";\\n\\nconst COLOURS = [\\n  { label: \\\"Blue\\\", token: \\\"--color-cat-1\\\" },\\n  { label: \\\"Orange\\\", token: \\\"--color-cat-6\\\" },\\n  { label: \\\"Violet\\\", token: \\\"--color-cat-5\\\" },\\n];\\n\\nexport default function App() {\\n  const [colour, setColour] = useState(COLOURS[0].token);\\n\\n  return (\\n    \u003cAppShell\u003e\\n      \u003cHeader title=\\\"Colour Greeting\\\" /\u003e\\n      \u003cmain className=\\\"content\\\"\u003e\\n        \u003ch1 className=\\\"greeting\\\" style={{ color: `var(${colour})` }}\u003e\\n          Hello, world!\\n        \u003c/h1\u003e\\n        \u003cdiv className=\\\"button-row\\\"\u003e\\n          {COLOURS.map(({ label, token }) =\u003e (\\n            \u003cButton\\n              key={token}\\n              variant=\\\"secondary\\\"\\n              size=\\\"md\\\"\\n              onClick={() =\u003e setColour(token)}\\n            \u003e\\n              {label}\\n            \u003c/Button\u003e\\n          ))}\\n        \u003c/div\u003e\\n      \u003c/main\u003e\\n      \u003cFooter\u003eBuilt with the codesweep design system\u003c/Footer\u003e\\n    \u003c/AppShell\u003e\\n  );\\n}\\n"},"index":1}]},"finish_reason":null,"index":0,"raw_output":null}],"created":1793343039,"id":"chatcmpl-022e7acd","model":"accounts/fireworks/models/kimi-k3","object":"chat.completion.chunk","usage":null}

