data: {"choices":[{"delta":{"tool_calls":[{"function":{"arguments":"{\"content\": \"import React, { useState } from \\\"react\\\";\\nimport { AppShell, Header, Footer, Page, Card, Button } from \\\"@codesweep-ai/ui\\\";\\nimport \\\"@codesweep-ai/ui/styles/core.css\\\";\\nimport \\\"@codesweep-ai/ui/styles/components/app-shell.css\\\";\\nimport \\\"@codesweep-ai/ui/styles/components/button.css\\\";\\nimport \\\"@codesweep-ai/ui/styles/components/card.css\\\";\\nimport \\\"@codesweep-ai/ui/styles/components/page.css\\\";\\n\\nconst colourMap = [\\n  { label: \\\"Blue\\\", token: \\\"var(--color-info)\\\" },\\n  { label: \\\"Green\\\", token: \\\"var(--color-success)\\\" },\\n  { label: \\\"Amber\\\", token: \\\"var(--color-warning)\\\" },\\n  { label: \\\"Red\\\", token: \\\"var(--color-error)\\\" },\\n];\\n\\nexport default function App() {\\n  const [colour, setColour] = useState(colourMap[0].token);\\n\\n  return (\\n    \u003cAppShell\u003e\\n      \u003cHeader title=\\\"Hello App\\\" /\u003e\\n      \u003cdiv\\n        style={{\\n          flex: \\\"1 1 auto\\\",\\n          display: \\\"flex\\\",\\n          alignItems: \\\"center\\\",\\n          justifyContent: \\\"center\\\",\\n        }}\\n      \u003e\\n        \u003cPage style={{ alignItems: \\\"center\\\", justifyContent: \\\"center\\\" }}\u003e\\n          \u003cCard style={{ textAlign: \\\"center\\\" }}\u003e\\n            \u003ch1\\n              style={{\\n                fontSize: \\\"var(--font-size-prose-h1)\\\",\\n                fontWeight: \\\"var(--font-weight-bold)\\\",\\n                textAlign: \\\"center\\\",\\n                color: colour,\\n                marginBottom: \\\"var(--space-4)\\\",\\n              }}\\n            \u003e\\n              Hello, world!\\n            \u003c/h1\u003e\\n            \u003cdiv\\n              style={{\\n                display: \\\"flex\\\",\\n                justifyContent: \\\"center\\\",\\n                gap: \\\"var(--space-2)\\\",\\n              }}\\n            \u003e\\n              {colourMap.map(({ label, token }) =\u003e (\\n                \u003cButton\\n                  key={label}\\n                  variant={colour === token ? \\\"primary\\\" : \\\"secondary\\\"}\\n                  onClick={() =\u003e setColour(token)}\\n                \u003e\\n                  {label}\\n                \u003c/Button\u003e\\n              ))}\\n            \u003c/div\u003e\\n          \u003c/Card\u003e\\n        \u003c/Page\u003e\\n      \u003c/div\u003e\\n      \u003cFooter style={{ textAlign: \\\"center\\\" }}\u003e\\n        Built with @codesweep-ai/ui\\n      \u003c/Footer\u003e\\n    \u003c/AppShell\u003e\\n  );\\n}\\n\", \"filePath\": \"/home/<USER:1>/hello-app/src/App.jsx\"}","name":"write"},"id":"write_52","index":0,"type":"function"}]},"finish_reason":null,"index":0,"raw_output":null}],"created":1789959324,"id":"chatcmpl-fdeae842f70b4fabac46e0745b4da7eb","model":"accounts/fireworks/models/kimi-k2p7-code","object":"chat.completion.chunk","usage":null}

