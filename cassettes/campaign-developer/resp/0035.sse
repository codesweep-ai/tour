data: {"choices":[{"delta":{"tool_calls":[{"function":{"arguments":"{\"content\": \"import { useState } from 'react'\\nimport { AppShell, Header, Footer, Button } from '@codesweep-ai/ui'\\n\\nconst COLOURS = [\\n  { label: 'Teal', token: 'var(--color-cat-2)', variant: 'secondary' },\\n  { label: 'Amber', token: 'var(--color-cat-3)', variant: 'warning' },\\n  { label: 'Rose', token: 'var(--color-cat-4)', variant: 'danger' },\\n  { label: 'Sky', token: 'var(--color-cat-9)', variant: 'primary' },\\n]\\n\\nfunction App() {\\n  const [greetingColour, setGreetingColour] = useState('var(--color-cat-2)')\\n\\n  return (\\n    \u003cAppShell\u003e\\n      \u003cHeader title=\\\"Hello\\\" /\u003e\\n      \u003cmain\\n        style={{\\n          display: 'flex',\\n          flexDirection: 'column',\\n          alignItems: 'center',\\n          justifyContent: 'center',\\n          gap: 'var(--space-4)',\\n          width: '100%',\\n          height: '100%',\\n        }}\\n      \u003e\\n        \u003ch1\\n          style={{\\n            color: greetingColour,\\n            fontSize: 'var(--font-size-3xl)',\\n            fontWeight: 'var(--font-weight-bold)',\\n            margin: 0,\\n          }}\\n        \u003e\\n          Hello, world!\\n        \u003c/h1\u003e\\n        \u003cdiv\\n          style={{\\n            display: 'flex',\\n            flexDirection: 'row',\\n            justifyContent: 'center',\\n            gap: 'var(--space-4)',\\n          }}\\n        \u003e\\n          {COLOURS.map(({ label, token, variant }) =\u003e (\\n            \u003cButton\\n              key={label}\\n              variant={variant}\\n              onClick={() =\u003e setGreetingColour(token)}\\n            \u003e\\n              {label}\\n            \u003c/Button\u003e\\n          ))}\\n        \u003c/div\u003e\\n      \u003c/main\u003e\\n      \u003cFooter\u003eBuilt with @codesweep-ai/ui\u003c/Footer\u003e\\n    \u003c/AppShell\u003e\\n  )\\n}\\n\\nexport default App\\n\", \"filePath\": \"/home/<USER:1>/hello-app/src/App.jsx\"}","name":"write"},"id":"write_32","index":0,"type":"function"}]},"finish_reason":null,"index":0,"raw_output":null}],"created":1789849130,"id":"chatcmpl-5a78f21fbb5c4de48c628b9996e62fde","model":"accounts/fireworks/models/kimi-k2p7-code","object":"chat.completion.chunk","usage":null}

