data: {"choices":[{"delta":{"tool_calls":[{"function":{"arguments":"{\"content\": \"const puppeteer = require('puppeteer');\\n\\nconst checks = {\\n  passed: [],\\n  failed: [],\\n};\\n\\nfunction pass(msg) {\\n  checks.passed.push(msg);\\n  console.log(`PASS: ${msg}`);\\n}\\n\\nfunction fail(msg, evidence) {\\n  checks.failed.push({ msg, evidence });\\n  console.log(`FAIL: ${msg}`);\\n  if (evidence) console.log(`  Evidence: ${JSON.stringify(evidence)}`);\\n}\\n\\n(async () =\u003e {\\n  const browser = await puppeteer.launch({\\n    headless: true,\\n    executablePath: '/usr/bin/chromium-browser',\\n    args: ['--no-sandbox', '--disable-setuid-sandbox'],\\n  });\\n  const page = await browser.newPage();\\n\\n  try {\\n    await page.goto('http://localhost:5173/', { waitUntil: 'networkidle2' });\\n    await page.waitForTimeout(1000);\\n\\n    // Header title\\n    const headerTitle = await page.$eval('[data-component=\\\"Header\\\"]', el =\u003e el.textContent).catch(() =\u003e null);\\n    if (headerTitle === 'Hello App') pass('Header title is \\\"Hello App\\\"');\\n    else fail('Header title should be \\\"Hello App\\\"', { headerTitle });\\n\\n    // Footer text\\n    const footerText = await page.$eval('[data-component=\\\"Footer\\\"]', el =\u003e el.textContent).catch(() =\u003e null);\\n    if (footerText \u0026\u0026 footerText.includes('Built with @codesweep-ai/ui')) pass('Footer text contains \\\"Built with @codesweep-ai/ui\\\"');\\n    else fail('Footer text should contain \\\"Built with @codesweep-ai/ui\\\"', { footerText });\\n\\n    // Greeting text\\n    const greeting = await page.$eval('h1', el =\u003e el.textContent).catch(() =\u003e null);\\n    if (greeting === 'Hello, world!') pass('Greeting text is \\\"Hello, world!\\\"');\\n    else fail('Greeting text should be \\\"Hello, world!\\\"', { greeting });\\n\\n    // Greeting style\\n    const greetingStyles = await page.$eval('h1', el =\u003e {\\n      const s = window.getComputedStyle(el);\\n      return {\\n        fontSize: s.fontSize,\\n        fontWeight: s.fontWeight,\\n        textAlign: s.textAlign,\\n        color: s.color,\\n      };\\n    }).catch(() =\u003e null);\\n    if (greetingStyles) {\\n      console.log('Greeting computed styles:', JSON.stringify(greetingStyles));\\n      if (parseFloat(greetingStyles.fontWeight) \u003e= 700) pass('Greeting is bold');\\n      else fail('Greeting should be bold', { fontWeight: greetingStyles.fontWeight });\\n      if (greetingStyles.textAlign === 'center') pass('Greeting is centered');\\n      else fail('Greeting should be centered', { textAlign: greetingStyles.textAlign });\\n    } else {\\n      fail('Could not read greeting styles');\\n    }\\n\\n    // Button labels\\n    const buttons = await page.$$eval('[data-component=\\\"Button\\\"]', btns =\u003e btns.map(b =\u003e b.textContent.trim()));\\n    if (JSON.stringify(buttons) === JSON.stringify(['Blue', 'Green', 'Amber', 'Red'])) {\\n      pass('Buttons are Blue, Green, Amber, Red in order');\\n    } else {\\n      fail('Button labels should be Blue, Green, Amber, Red', { buttons });\\n    }\\n\\n    // Active button initially should be Blue/primary\\n    const initialVariants = await page.$$eval('[data-component=\\\"Button\\\"]', btns =\u003e\\n      btns.map(b =\u003e b.getAttribute('data-variant'))\\n    );\\n    console.log('Initial button variants:', JSON.stringify(initialVariants));\\n    if (initialVariants[0] === 'primary' \u0026\u0026 initialVariants.slice(1).every(v =\u003e v === 'secondary')) {\\n      pass('Initial active button (Blue) is primary, others secondary');\\n    } else {\\n      fail('Initial Blue button should be primary and others secondary', { initialVariants });\\n    }\\n\\n    // Click each button and check greeting color + active variant\\n    const expectedTokens = [\\n      { label: 'Blue', token: 'var(--color-info)', rgb: null },\\n      { label: 'Green', token: 'var(--color-success)', rgb: null },\\n      { label: 'Amber', token: 'var(--color-warning)', rgb: null },\\n      { label: 'Red', token: 'var(--color-error)', rgb: null },\\n    ];\\n\\n    for (let i = 0; i \u003c expectedTokens.length; i++) {\\n      const { label } = expectedTokens[i];\\n      await page.click(`button:has-text(\\\"${label}\\\")`);\\n      await page.waitForTimeout(200);\\n\\n      const color = await page.$eval('h1', el =\u003e window.getComputedStyle(el).color);\\n      expectedTokens[i].rgb = color;\\n      console.log(`${label} clicked -\u003e greeting color: ${color}`);\\n\\n      const variants = await page.$$eval('[data-component=\\\"Button\\\"]', btns =\u003e\\n        btns.map(b =\u003e b.getAttribute('data-variant'))\\n      );\\n      if (variants[i] === 'primary' \u0026\u0026 variants.filter((_, idx) =\u003e idx !== i).every(v =\u003e v === 'secondary')) {\\n        pass(`${label} button active variant is primary, others secondary`);\\n      } else {\\n        fail(`${label} button should be primary and others secondary`, { variants, clicked: label });\\n      }\\n    }\\n\\n    // Verify colors changed across clicks (distinct values)\\n    const colors = expectedTokens.map(t =\u003e t.rgb);\\n    const uniqueColors = [...new Set(colors)];\\n    if (uniqueColors.length === 4) pass('All four colour clicks produce distinct greeting colours');\\n    else fail('Colour clicks should produce four distinct colours', { colors });\\n\\n    // Check data-component attributes\\n    const requiredComponents = ['Header', 'Footer', 'Button', 'Card', 'Page', 'AppShell'];\\n    for (const name of requiredComponents) {\\n      const exists = await page.$(`[data-component=\\\"${name}\\\"]`) !== null;\\n      if (exists) pass(`Rendered [data-component=\\\"${name}\\\"]`);\\n      else fail(`Missing [data-component=\\\"${name}\\\"]`);\\n    }\\n\\n    // Layout: Card centered between Header and Footer\\n    const cardBox = await page.$eval('[data-component=\\\"Card\\\"]', el =\u003e {\\n      const rect = el.getBoundingClientRect();\\n      return { top: rect.top, left: rect.left, width: rect.width, height: rect.height };\\n    }).catch(() =\u003e null);\\n    const pageBox = await page.$eval('[data-component=\\\"Page\\\"]', el =\u003e {\\n      const rect = el.getBoundingClientRect();\\n      return { top: rect.top, left: rect.left, width: rect.width, height: rect.height };\\n    }).catch(() =\u003e null);\\n    if (cardBox \u0026\u0026 pageBox) {\\n      const cardCenterX = cardBox.left + cardBox.width / 2;\\n      const cardCenterY = cardBox.top + cardBox.height / 2;\\n      const pageCenterX = pageBox.left + pageBox.width / 2;\\n      const pageCenterY = pageBox.top + pageBox.height / 2;\\n      const xOff = Math.abs(cardCenterX - pageCenterX);\\n      const yOff = Math.abs(cardCenterY - pageCenterY);\\n      console.log(`Card center offset: x=${xOff}, y=${yOff}`);\\n      if (xOff \u003c= 1 \u0026\u0026 yOff \u003c= 1) pass('Card is centred in the page content area');\\n      else fail('Card should be centred in the page content area', { cardBox, pageBox, xOff, yOff });\\n    } else {\\n      fail('Could not measure Card/Page layout', { cardBox, pageBox });\\n    }\\n\\n  } catch (e) {\\n    fail(`Script error: ${e.message}`);\\n    console.error(e);\\n  } finally {\\n    await browser.close();\\n  }\\n\\n  console.log('\\\\n=== SUMMARY ===');\\n  console.log(`Passed: ${checks.passed.length}`);\\n  console.log(`Failed: ${checks.failed.length}`);\\n  if (checks.failed.length \u003e 0) {\\n    console.log('Failed checks:');\\n    checks.failed.forEach(f =\u003e console.log(` - ${f.msg}: ${JSON.stringify(f.evidence)}`));\\n    process.exit(1);\\n  }\\n})();\\n\", \"filePath\": \"/tmp/verify.js\"}","name":"write"},"id":"write_23","index":0,"type":"function"}]},"finish_reason":null,"index":0,"raw_output":null}],"created":1789959494,"id":"chatcmpl-0d1b1917d28d4a3e8764ecb621c59d7d","model":"accounts/fireworks/models/kimi-k2p7-code","object":"chat.completion.chunk","usage":null}

