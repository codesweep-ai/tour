data: {"choices":[{"delta":{"reasoning_content":"Now let me write a verification script using puppeteer-core."},"finish_reason":null,"index":0,"raw_output":null}],"created":1789849417,"id":"chatcmpl-43abb2ccadba447184edebbd18dd21de","model":"accounts/fireworks/models/kimi-k2p7-code","object":"chat.completion.chunk","usage":null}

data: {"choices":[{"delta":{"tool_calls":[{"function":{"arguments":"{\"content\": \"const puppeteer = require('puppeteer-core');\\n\\nconst CHROMIUM = '/usr/bin/chromium-browser';\\nconst URL = 'http://localhost:5173/';\\n\\n(async () =\u003e {\\n  const browser = await puppeteer.launch({\\n    executablePath: CHROMIUM,\\n    headless: true,\\n    args: ['--no-sandbox', '--disable-gpu'],\\n  });\\n\\n  try {\\n    const page = await browser.newPage();\\n    await page.goto(URL, { waitUntil: 'networkidle2' });\\n\\n    const checks = [];\\n\\n    // Helper to get greeting color style\\n    const getGreetingColor = async () =\u003e {\\n      return page.$eval('h1', (el) =\u003e el.style.color);\\n    };\\n\\n    const getGreetingText = async () =\u003e {\\n      return page.$eval('h1', (el) =\u003e el.textContent);\\n    };\\n\\n    const getHeaderTitle = async () =\u003e {\\n      return page.$eval('[data-component=\\\"Header\\\"]', (el) =\u003e el.textContent);\\n    };\\n\\n    const getFooterText = async () =\u003e {\\n      return page.$eval('[data-component=\\\"Footer\\\"]', (el) =\u003e el.textContent);\\n    };\\n\\n    const getButtonLabels = async () =\u003e {\\n      return page.$$eval('[data-component=\\\"Button\\\"]', (btns) =\u003e btns.map((b) =\u003e b.textContent));\\n    };\\n\\n    checks.push({ label: 'Header title', expected: 'Hello', actual: await getHeaderTitle() });\\n    checks.push({ label: 'Footer text', expected: 'Built with @codesweep-ai/ui', actual: await getFooterText() });\\n    checks.push({ label: 'Greeting text', expected: 'Hello, world!', actual: await getGreetingText() });\\n    checks.push({ label: 'Default greeting colour', expected: 'var(--color-cat-2)', actual: await getGreetingColor() });\\n    checks.push({ label: 'Button labels', expected: 'Teal,Amber,Rose,Sky', actual: (await getButtonLabels()).join(',') });\\n\\n    const expectedTokens = [\\n      { label: 'Teal', token: 'var(--color-cat-2)' },\\n      { label: 'Amber', token: 'var(--color-cat-3)' },\\n      { label: 'Rose', token: 'var(--color-cat-4)' },\\n      { label: 'Sky', token: 'var(--color-cat-9)' },\\n    ];\\n\\n    for (const { label, token } of expectedTokens) {\\n      const button = await page.$(`[data-component=\\\"Button\\\"]:has-text(\\\"${label}\\\")`);\\n      if (!button) {\\n        checks.push({ label: `${label} button exists`, expected: true, actual: false });\\n        continue;\\n      }\\n      await button.click();\\n      await page.waitForTimeout(100); // allow React state update\\n      const color = await getGreetingColor();\\n      checks.push({ label: `${label} button colour`, expected: token, actual: color });\\n    }\\n\\n    console.log(JSON.stringify(checks, null, 2));\\n\\n    const failures = checks.filter((c) =\u003e c.expected !== c.actual);\\n    if (failures.length \u003e 0) {\\n      console.error('\\\\nFailures:');\\n      failures.forEach((f) =\u003e console.error(`  ${f.label}: expected \\\"${f.expected}\\\", got \\\"${f.actual}\\\"`));\\n      process.exit(1);\\n    }\\n    console.log('\\\\nAll checks passed.');\\n  } finally {\\n    await browser.close();\\n  }\\n})();\\n\", \"filePath\": \"/tmp/verify-hello/verify.js\"}","name":"write"},"id":"write_25","index":0,"type":"function"}]},"finish_reason":null,"index":0,"raw_output":null}],"created":1789849417,"id":"chatcmpl-43abb2ccadba447184edebbd18dd21de","model":"accounts/fireworks/models/kimi-k2p7-code","object":"chat.completion.chunk","usage":null}

