apiVersion: codesweep.ai/v1alpha1
kind: CampaignProfile
# Rendered by `make demo-profile`. @REPO@ becomes an absolute path under .work,
# which does not exist yet, so `create` makes an empty repository with a fixed
# first commit as the base. Nothing here is committed to this repository.
defaults:
  engine: firecracker
  deadline: 2h
  credentials: lend
  # 2048 is not enough. The opencode server and its attached run hold about 1 GiB
  # between them, so an `npm install` or a Vite server on top of that ends with the
  # kernel killing the agent. The member then sits idle until it is prodded.
  resources: {cpus: 2, memoryMiB: 4096}
orchestrator:
  cli: opencode
  model: @MODEL@
  repos: [{path: @REPO@}]
  auth: {apiKey: [fireworks]}
agents:
  developer:
    cli: opencode
    model: @MODEL@
    repos: [{path: @REPO@}]
    auth: {apiKey: [fireworks]}
  qa:
    cli: opencode
    model: @MODEL@
    repos: [{path: @REPO@}]
    auth: {apiKey: [fireworks]}
