# Every tool: pinned in the Makefile and fetched by `make tools`. Binaries are build
# output, never committed.
tools/

# npm's install directory. Nothing here runs npm, and a clone that has one can delete it.
node_modules/

# Campaign workspace, throwaway app repo, port-forward state.
.work/

# Local secrets. The campaign key lives in ~/.cs-keys, never in this tree.
.env
.env.*
